# Docker Compose host ports
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL credentials (replace the example password before deployment)
POSTGRES_USER=leadharbor
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=leadharbor

# App URLs for running locally outside Docker; Compose overrides these in containers
DATABASE_URL=postgresql+asyncpg://leadharbor:change-this-password@localhost:5432/leadharbor
DATABASE_URL_SYNC=postgresql+psycopg://leadharbor:change-this-password@localhost:5432/leadharbor

# Queue URLs for running locally outside Docker; Compose overrides these in containers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 目标市场（中亚优先，ISO 3166-1 alpha-2，逗号分隔）
TARGET_COUNTRIES=KZ,UZ,KG,TJ,TM
DEFAULT_REGION=KZ

# Collector
GOOGLE_PLACES_API_KEY=
TWOGIS_API_KEY=
# Google 可编程搜索（直接按关键词找公司官网）
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# OpenStreetMap Overpass 免费开放数据（公共实例会限流）
OVERPASS_URL=https://overpass-api.de/api/interpreter
# OpenCorporates 公司注册数据（免费额度 + token）
OPENCORPORATES_API_TOKEN=
# AI 研究员（按 OpenAI token 计费，结果需核实）
AI_RESEARCHER_ENABLED=false
AI_RESEARCHER_MODEL=gpt-4o-mini
CRAWLER_USER_AGENT=LeadHarborBot/0.1 (+contact@example.com)
CRAWLER_MAX_CONCURRENCY=5
CRAWLER_REQUESTS_PER_SECOND=2

# AI（支持任意 OpenAI 兼容接口，如 DeepSeek）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Email (later phase)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# Yandex Maps 官方 Geosearch API（中亚/俄语区）
YANDEX_GEOSEARCH_API_KEY=
YANDEX_GEOSEARCH_URL=https://search-maps.yandex.ru/v1/
